#!/bin/bash
# Run Gemini CLI under agent-safehouse sandbox with cmux hook writes allowed.
PATH_RO="$("$(dirname "$0")/_safehouse-readable-path")"
exec safehouse \
  --enable=wide-read \
  --add-dirs-ro="$PATH_RO" \
  --add-dirs="$HOME/.cmuxterm:$HOME/.gemini:$HOME/.lmstudio:$HOME/.lmstudio-home-pointer" \
  -- gemini "$@"
