# with-secret aliases
# Format: <alias> <service> <account>
# Lines starting with # are comments. Account defaults to $USER if omitted.
#
# Lookup is: security find-generic-password -w -s <service> -a <account>
# Default if no alias matches: service=<name>, account=$USER

# Plane (stored under service=mcpproxy for keyring: substitution compatibility)
plane-api-key       mcpproxy api.plane.api_key
plane-base-url      mcpproxy api.plane.base_url
plane-workspace     mcpproxy api.plane.workspace_slug

# Freescout (same mcpproxy service)
freescout-api-key   mcpproxy freescout_api_key
freescout-url       mcpproxy freescout_url

# Zulip (whole .zuliprc, base64-wrapped with b64: prefix for multi-line safety)
zulip               zulip

# Windmill (whole NDJSON line, b64-wrapped). Use via the with-wmill wrapper:
#   with-wmill workspace whoami
#   with-wmill flow run f/cs/get_line_info -d '{"msisdn":"..."}'
wmill               wmill

# --- to be added during Phase 2 migration ---
# t3-bearer         t3-bearer
