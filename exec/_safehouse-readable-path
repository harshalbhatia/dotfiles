#!/bin/bash
# Print a colon-separated list of existing PATH directories, suitable for
# passing to `safehouse --add-dirs-ro=...`. Grants the sandboxed agent
# read+exec on every binary already reachable via the host's PATH.
# Filters out non-existent entries (safehouse rejects them).
out=""
IFS=':' read -ra parts <<< "$PATH"
for p in "${parts[@]}"; do
  [[ -n "$p" && -d "$p" ]] && out="${out:+$out:}$p"
done
printf '%s' "$out"
