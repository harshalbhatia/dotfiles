#!/bin/sh
# with-secret — resolve a macOS Keychain secret and inject into a child command.
#
# Usage:
#   with-secret <name> [--env[=VAR] | --file | --stdin] -- <cmd> [args...]
#
# Modes (default: --env):
#   --env[=VAR]   Set env var (default: <NAME> uppercased; dashes -> underscores)
#   --file        Write to mktemp (0600), set <VAR>_FILE=<path>, delete on exit
#   --stdin       Pipe value to <cmd>'s stdin (no disk, no env)
#
# Aliases file (whitespace-separated):  <alias> <service> <account>
#   Default if alias not found: service=<name>, account=$USER
#   Override path via $WITH_SECRET_ALIASES.

set -eu

ALIASES_FILE="${WITH_SECRET_ALIASES:-$(dirname "$0")/with-secret.aliases}"

usage() {
    cat >&2 <<EOF
Usage: with-secret <name> [--env[=VAR] | --file | --stdin] -- <cmd> [args...]

Modes (default: --env):
  --env[=VAR]   Set env var (default: <NAME> uppercased; dashes -> underscores)
  --file        Write to mktemp (0600), set <VAR>_FILE=<path>, delete on exit
  --stdin       Pipe value to <cmd>'s stdin (no disk, no env)

Aliases: $ALIASES_FILE
EOF
    exit 2
}

[ $# -ge 1 ] || usage
NAME=$1; shift

MODE=env
VAR=
while [ $# -gt 0 ]; do
    case $1 in
        --env)     MODE=env; shift ;;
        --env=*)   MODE=env; VAR=${1#--env=}; shift ;;
        --file)    MODE=file; shift ;;
        --stdin)   MODE=stdin; shift ;;
        --)        shift; break ;;
        -h|--help) usage ;;
        *)         echo "with-secret: unknown flag: $1" >&2; usage ;;
    esac
done

[ $# -ge 1 ] || { echo "with-secret: missing command after --" >&2; usage; }

# Resolve alias. Preserves "$@" by not using `set --` for the lookup.
SERVICE=$NAME
ACCOUNT=$USER
if [ -f "$ALIASES_FILE" ]; then
    while read -r a_alias a_svc a_acct _rest || [ -n "${a_alias:-}" ]; do
        case ${a_alias:-} in '#'*|'') continue ;; esac
        if [ "$a_alias" = "$NAME" ]; then
            SERVICE=${a_svc:-$NAME}
            ACCOUNT=${a_acct:-$USER}
            break
        fi
    done < "$ALIASES_FILE"
fi

# Default env var name: uppercase, dashes -> underscores
if [ -z "$VAR" ]; then
    VAR=$(printf '%s' "$NAME" | tr 'a-z-' 'A-Z_')
fi
# Sanity: VAR must be a valid env var identifier
case $VAR in
    [A-Z_]*) ;;
    *) echo "with-secret: invalid env var name: $VAR" >&2; exit 2 ;;
esac

# Fetch value. security writes to stdout; $(...) keeps it out of argv/logs.
VALUE=$(security find-generic-password -w -s "$SERVICE" -a "$ACCOUNT" 2>/dev/null) || {
    echo "with-secret: keychain lookup failed: name=$NAME service=$SERVICE account=$ACCOUNT" >&2
    exit 1
}

# Convention: multi-line / binary values are stored base64-encoded with a "b64:" prefix.
# (security -w auto-hex-encodes values containing non-printable bytes — base64 sidesteps that.)
IS_B64=0
ENCODED=
case $VALUE in
    b64:*)
        IS_B64=1
        ENCODED=${VALUE#b64:}
        VALUE=
        ;;
esac

case $MODE in
    env)
        if [ "$IS_B64" = 1 ]; then
            # Command sub will strip the single trailing \n that base64 adds;
            # acceptable for env (env vars don't preserve trailing newlines).
            VALUE=$(printf '%s' "$ENCODED" | base64 -d 2>/dev/null) || {
                echo "with-secret: base64 decode failed" >&2; exit 1
            }
        fi
        export "$VAR=$VALUE"
        VALUE=; ENCODED=; unset VALUE ENCODED
        exec "$@"
        ;;
    stdin)
        # Pipe value to child's stdin (no disk, no env).
        if [ "$IS_B64" = 1 ]; then
            printf '%s' "$ENCODED" | base64 -d | "$@"
        else
            printf '%s' "$VALUE" | "$@"
        fi
        ;;
    file)
        TMPFILE=$(mktemp -t with-secret) || exit 1
        chmod 600 "$TMPFILE"
        # /bin/rm to bypass any `rm`->trash alias
        trap '/bin/rm -f "$TMPFILE"' EXIT INT TERM HUP
        # Pipeline write preserves bytes exactly (no $() newline-stripping).
        if [ "$IS_B64" = 1 ]; then
            printf '%s' "$ENCODED" | base64 -d > "$TMPFILE" || {
                echo "with-secret: base64 decode failed" >&2; exit 1
            }
        else
            printf '%s' "$VALUE" > "$TMPFILE"
        fi
        VALUE=; ENCODED=; unset VALUE ENCODED
        export "${VAR}_FILE=$TMPFILE"
        "$@"
        ;;
esac
