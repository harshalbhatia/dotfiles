#!/bin/bash
# scco = "safe codex (yolo)" — codex equivalent of scc.
# Disables codex's internal sandbox/approvals and provides external isolation
# via agent-safehouse. Uses the mise shim so version bumps don't break the path.
exec safehouse \
  --enable=shell-init,ssh,cloud-credentials,docker \
  --add-dirs="$HOME/.cmuxterm:$HOME/.codex:$HOME/.lmstudio:$HOME/.lmstudio-home-pointer" \
  -- "$HOME/.local/share/mise/shims/codex" --dangerously-bypass-approvals-and-sandbox "$@"
